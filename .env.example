# ── Meshy ────────────────────────────────────────────────────────────────
# Get a key at https://www.meshy.ai → Settings → API Keys. NEVER commit the real key.
MESHY_API_KEY=
MESHY_API_BASE_URL=https://api.meshy.ai/openapi

# ── Unity MCP ────────────────────────────────────────────────────────────
# Streamable HTTP endpoint of a Unity MCP server (e.g. MCP for Unity HTTP mode):
UNITY_MCP_URL=http://localhost:8080/mcp
# Or launch Unity MCP as a child process (stdio mode), e.g. Unity official relay:
# UNITY_MCP_COMMAND=
# UNITY_MCP_PORT=8080
# Mapping profile: mcpforunity | unity-official | generic | mock
UNITY_MCP_PROFILE=generic
# Absolute path of the target Unity project (used for asset import destinations)
UNITY_PROJECT_PATH=

# ── GODCP paths ───────────────────────────────────────────────────────
GODCP_ASSET_DIR=./assets/generated
GODCP_CACHE_DIR=./assets/cache
GODCP_RENDER_DIR=./assets/renders
GODCP_STATE_DIR=./state
GODCP_REFERENCE_DIR=./assets/references

# ── Vision ───────────────────────────────────────────────────────────────
# heuristic = offline, no API key needed (lower fidelity)
# openai    = any OpenAI-compatible chat-completions endpoint with image support
VISION_PROVIDER=heuristic
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# ── Logging / runtime ────────────────────────────────────────────────────
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
# stdio | http
GODCP_TRANSPORT=stdio
GODCP_HTTP_PORT=3100

# ── Cost / safety controls ───────────────────────────────────────────────
GODCP_MAX_MESHY_GENERATIONS=20
GODCP_MAX_ITERATIONS=3
GODCP_DRY_RUN=false
GODCP_REQUIRE_GENERATION_APPROVAL=false
# Stop iterating once similarity reaches this value (0..1)
GODCP_SIMILARITY_TARGET=0.85
